DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=generate-a-secure-key-here
# Keep this key stable; existing encrypted files depend on it for data-key recovery.
FILE_ENCRYPTION_KEY=generate-a-separate-secure-key-here
HMAC_SECRET=generate-a-separate-secure-hmac-key-here
DATABASE_URL=postgres://sv_user:sv_pass@127.0.0.1:5432/shardvault
REDIS_URL=redis://127.0.0.1:6379/1